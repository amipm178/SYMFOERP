# Développement uniquement : remplacez chaque secret avant le premier démarrage.
APP_SECRET=replace-with-a-long-random-app-secret

# Base native Symfony
SYMFONY_DB_NAME=symfoerp
SYMFONY_DB_USER=symfoerp
SYMFONY_DB_PASSWORD=replace-with-a-strong-symfony-db-password
SYMFONY_DB_ROOT_PASSWORD=replace-with-a-strong-symfony-root-password

# Installation neuve Dolibarr 24.0.2 (ne pas réutiliser de base ancienne)
DOLI_DB_NAME=dolibarr
DOLI_DB_USER=dolibarr
DOLI_DB_PASSWORD=replace-with-a-strong-dolibarr-db-password
DOLI_DB_ROOT_PASSWORD=replace-with-a-strong-dolibarr-root-password
DOLI_ADMIN_LOGIN=admin
DOLI_ADMIN_PASSWORD=replace-with-a-strong-dolibarr-admin-password
DOLI_INSTANCE_UNIQUE_ID=replace-with-a-long-random-instance-id
